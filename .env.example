# Video Localization Environment Configuration
# Copy this file to .env and fill in your API keys

# Translation API Keys
OPENAI_API_KEY=your_openai_api_key_here
DEEPL_API_KEY=your_deepl_api_key_here

# API Base URLs (optional - use custom endpoints)
OPENAI_BASE_URL=
DEEPL_BASE_URL=

# Default Providers
DEFAULT_TTS_PROVIDER=edge
DEFAULT_TRANSCRIPTION_PROVIDER=whisper
DEFAULT_TRANSLATION_PROVIDER=openai
DEFAULT_AUDIO_QUALITY=high

# Tool Paths (optional - will use system PATH if not specified)
FFMPEG_PATH=
WHISPER_PATH=

# Whisper Configuration
WHISPER_MODEL=base

# Edge TTS Configuration
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_VOLUME=+0%
EDGE_TTS_PITCH=+0Hz

# Processing Configuration
FFMPEG_TIMEOUT=300000
KEEP_INTERMEDIATE_FILES=false

# Log Level (debug, info, warn, error)
LOG_LEVEL=info