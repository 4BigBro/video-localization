{
  "name": "video-localization",
  "version": "1.0.0",
  "description": "Automated video localization pipeline for converting English videos to Chinese dubbed videos",
  "main": "dist/index.js",
  "bin": {
    "video-localize": "dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/cli/index.ts",
    "build": "tsc && chmod +x dist/cli/index.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src/**/*.{ts,tsx}",
    "setup": "node scripts/setup.js",
    "process": "tsx src/cli/index.ts"
  },
  "keywords": [
    "video",
    "localization",
    "translation",
    "tts",
    "chinese",
    "subtitles",
    "ffmpeg",
    "whisper"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^11.0.0",
    "chalk": "^5.3.0",
    "ora": "^7.0.1",
    "inquirer": "^9.2.0",
    "ffmpeg-static": "^5.2.0",
    "node-fetch": "^3.3.2",
    "form-data": "^4.0.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.5.0",
    "@types/inquirer": "^9.0.3",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@typescript-eslint/parser": "^6.4.0",
    "eslint": "^8.47.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.2",
    "typescript": "^5.1.6",
    "tsx": "^3.12.7",
    "vitest": "^0.34.3",
    "@vitest/coverage-v8": "^0.34.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ]
}